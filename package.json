{
  "name": "@prestizni-software/dem-publisher",
  "version": "0.1",
  "description": "An solution for when making http requests is not a good solution",
  "keywords": [
    "websockets"
  ],
  "license": "ISC",
  "author": "xx0055",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsc",
    "release": "node scripts/release.js patch",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "r": "npm run release",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/ --testPathIgnorePatterns=tests/issue_regression.test.ts --detectOpenHandles --forceExit",
    "test:basic": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/ --testPathIgnorePatterns=\"(issue_regression|performance)\" --detectOpenHandles --forceExit",
    "test:perf": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/performance.test.ts --detectOpenHandles --forceExit",
    "test:optional": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/issue_regression.test.ts --detectOpenHandles --forceExit",
    "test_for_AI": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/ --testPathIgnorePatterns=tests/issue_regression.test.ts --detectOpenHandles --forceExit --silent --verbose=false",
    "fix_all": "npm --prefix ../client audit fix && npm --prefix ../server audit fix && npm audit fix"
  },
  "dependencies": {
    "@typegoose/typegoose": "^13.5.0",
    "eventemitter3": "^5.0.4",
    "lodash": "^4.18.1",
    "node-machine-id": "^1.1.12",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "string-similarity-js": "^2.1.4"
  },
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
